# git-pullkeep is checked out with LF: the shebang is executed by bash on Linux/macOS
# and by Git-for-Windows' bundled bash on Windows.
git-pullkeep      text eol=lf
*.sh              text eol=lf
install.ps1       text eol=crlf
man/*.1           text eol=lf
package.json      text eol=lf
*.yml             text eol=lf
